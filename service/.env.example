# Ghost Mode service configuration (copy to .env; never commit .env)
# Comma-separated RPC list = fallback transport. With ../../.secrets/alchemy.txt present, Alchemy is used first.
RPC_URL=https://mainnet.base.org,https://base-rpc.publicnode.com
CHAIN_ID=8453
# Live v3 pool on Base mainnet (see README "Deployed addresses")
POOL_ADDRESS=0x314EAAdE3E1a42627b5D2c6b1f87D0bbd67B8367
POOL_DEPLOY_BLOCK=52741965
TOKEN=0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913
# Relayer key: RELAYER_PRIVATE_KEY env, else ../../.secrets/relayer.key (never commit it)
RELAYER_FEE=10000
ASP_DELAY_SECONDS=0
ASP_DENYLIST=
X402_MAX_AMOUNT=1000000
LOG_CHUNK=10000
PORT=8787
RATE_LIMIT_PER_MIN=300
# Absolute path to the compiled circuit (defaults to ../circuits/transact/target/transact.json)
# CIRCUIT_PATH=
